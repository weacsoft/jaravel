<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Jaravel 标准模板项目
        ============================================================
        只需引入 starter 依赖，即可获得全部 Laravel 风格功能：
        配置 / 路由 / 中间件 / Auth / Eloquent ORM / 迁移 / 缓存 / 事件 / 校验
        SpringBoot 原生能力（@Controller / @RequestMapping 等）完全保留。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.weacsoft</groupId>
    <artifactId>jaravel</artifactId>
    <version>0.1.2</version>
    <name>jaravel</name>
    <description>多租户 Jar/Java 热更新在线运行平台</description>

    <properties>
        <java.version>17</java.version>
        <!--
            jaravel-vendor 各模块版本。
            本地开发对接 jaravel-vendor 源码时使用 SNAPSHOT，需先在 jaravel-vendor 执行
            mvn install；发布正式版时改为 0.1.2 即可。
        -->
        <jaravel.version>0.1.2-SNAPSHOT</jaravel.version>
    </properties>

    <!-- gaarason ORM 来自 jitpack，需声明此仓库 -->
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- 引入 jaravel-vendor 全部能力（一行依赖即可） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>starter</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- 文件存储模块（多磁盘抽象：local/public 驱动 + 扩展的 database 驱动） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>storage</artifactId>
            <version>${jaravel.version}</version>
        </dependency>


        <!-- JWT 可选模块（starter 不聚合，按需引入） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>jwt</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- 插件系统模块（可选，按需引入） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>plugin-jar-core</artifactId>
            <version>${jaravel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>plugin-jar-database</artifactId>
            <version>${jaravel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>plugin-java-core</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- 多租户插件支持（可选，按需引入） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>plugin-jar-multi-tenant</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- 远程执行服务端（可选，P2SP 子节点） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>plugin-jar-remote-server</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- 远程执行客户端（可选，P2SP 主节点） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>plugin-jar-remote-client</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- jblade 模板引擎（显式声明，便于直接使用 BladeEngine） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>jblade</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- 自带验证码模块（支持数字、算术、滑动、旋转、文字点选） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>captcha</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- Wire 部分更新模块（Laravel Livewire 风格，支持自定义 update URL 和 @section 无感更新） -->
        <dependency>
            <groupId>io.github.lijialong1313</groupId>
            <artifactId>wire</artifactId>
            <version>${jaravel.version}</version>
        </dependency>

        <!-- Druid 数据源（手动创建 GaarasonDataSource） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
            <version>1.2.22</version>
        </dependency>

        <!-- gaarason database-query（ORM 核心，不含自动配置） -->
        <dependency>
            <groupId>io.github.gaarason</groupId>
            <artifactId>database-query</artifactId>
            <version>7.0.15</version>
        </dependency>

        <!-- Lombok（jaravel-vendor 中为 optional，不传递，需在此声明） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- SQLite 驱动（测试用文件数据库） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.1.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 可选：MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>--add-opens=java.base/java.lang=ALL-UNNAMED -Dserver.port=8080</jvmArguments>
                </configuration>
            </plugin>

            <!--
                预编译 Blade 模板：在 generate-resources 阶段运行 jblade 预编译器，
                将所有 .blade.java 模板编译为字节码并打包为 templates.jblade.zip，
                放置到 target/classes 中，最终打入 JAR。
                这样运行时只需 JRE，无需 JDK。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>precompile-blade-templates</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.weacsoft.jaravel.vendor.jblade.BladePrecompilerMain</mainClass>
                            <arguments>
                                <argument>--template-dir=${project.basedir}/src/main/resources/templates</argument>
                                <argument>--suffix=.blade.java</argument>
                                <argument>--output-dir=${project.build.directory}/jblade-precompiled</argument>
                                <argument>--mode=packaged</argument>
                                <argument>--package-name=</argument>
                                <argument>--file-suffix=.jblade.zip</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <!-- 依赖 jblade jar 来运行预编译器 -->
                <dependencies>
                    <dependency>
                        <groupId>io.github.lijialong1313</groupId>
                        <artifactId>jblade</artifactId>
                        <version>${jaravel.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- 将预编译产物复制到 resources 目录，确保打入 JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-precompiled-templates</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/jblade-precompiled</directory>
                                    <includes>
                                        <include>templates.jblade.zip</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

